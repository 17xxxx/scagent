# 行尾与二进制标记 —— 统一为 LF，避免 Windows 编辑把 diff 变成整文件噪声
* text=auto eol=lf

*.py    text eol=lf
*.R     text eol=lf
*.r     text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows 侧脚本保留 CRLF
#   *.ps1 必须是 UTF-8 **with BOM**：Windows PowerShell 5.1 读不含 BOM 的脚本时
#   按 ANSI 解码，脚本里的中文会乱码甚至语法报错。
#   注意：**不要**用 git 的 working-tree-encoding 属性实现 —— 实测本机 git 报
#   "failed to encode ... from UTF-8-BOM to UTF-8" 并阻断 git add/status。
#   BOM 作为文件内容由 git 原样保存，因此这里只需保证"别让编辑器把 BOM 删掉"。
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制（禁止任何行尾转换）
*.rds       binary
*.RDS       binary
*.pdf       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gz        binary
*.tgz       binary
*.zip       binary
*.zst       binary
*.tar       binary
*.mtx       binary
*.tsv       binary
*.h5        binary
*.h5ad      binary
*.sqlite    binary
