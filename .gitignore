# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Docker
.docker/
docker-backups/

# IDE
.vscode/
.idea/

# Data
data/

# Tutorial
langchain教程/

# Env —— .env.sample 必须保留在仓库中作为配置模板
.env
.env.*
!.env.sample

# Windows 元数据垃圾（从 Windows 拷贝文件时产生）
*:Zone.Identifier

# 备份与构建产物
*.bak
*.orig
bundle/
dist/

# 运行时状态（SQLite 会话检查点等）
state/

# 开发用参考数据目录（只读挂载到容器 /ref）
.biodata/

# Docker secrets（绝不入库）
secrets/
deploy/secrets/

# 未使用的离线 R 包仓（最大 100 MB，超 GitHub 单文件限制）
# 需要时由 scripts/install_r_deps.R 从镜像源安装
shared_data/*.tar.gz

# 内部文档（本地保留备查，不公开、不推送）
#   CHANGELOG / PROD_HANDOVER / DEPLOY_TUTORIAL 等含内部部署细节，
#   不适合开源；如需彻底删除： rm -rf docs/
docs/
