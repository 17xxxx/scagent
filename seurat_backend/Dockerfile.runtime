# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  seurat_backend/Dockerfile.runtime —— R 生信运行时镜像                       ║
# ║                                                                              ║
# ║  这是「搬运一次、很少重建」的重型镜像（≈4 GB），包含：                       ║
# ║    rocker/tidyverse + 系统依赖 + 108 个 R 包（17 个直接依赖的完整闭包）      ║
# ║                                                                              ║
# ║  分层方式：                                                                  ║
# ║    第三方运行时（很少变化）与应用代码（经常变化）分成两层：                  ║
# ║    改一行 R 代码只需重建约 10 MB 的应用层，不必重装 108 个包。               ║
# ║                                                                              ║
# ║  构建机要求：能访问 PPM（CRAN + Bioconductor 二进制源）                      ║
# ║  部署机要求：无 —— 只需要从私有 registry 拉取本镜像                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

FROM rocker/tidyverse:4.5.2

LABEL scagent.component="runtime" \
      scagent.r.version="4.5.2" \
      scagent.bioc.version="3.22"

# ── 系统依赖 ──────────────────────────────────────────────────────────────────
#  可选的 apt 镜像源（受限网络下用）：
#   默认留空 = 用官方源（archive/security.ubuntu.com）。若你的网络访问官方源不稳定
#   （常见表现：`apt-get` 退出码 100、卡在 Get/InRelease），可换国内镜像：
#       docker compose -f deploy/docker-compose.build.yml build \
#         --build-arg APT_MIRROR=https://mirrors.aliyun.com/ubuntu runtime
#   或在 deploy/.env 里写一行 `APT_MIRROR=https://mirrors.aliyun.com/ubuntu`
#   （build.sh / deploy\scagent.cmd build 会自动透传）。
#   ⚠️ 请在**首次构建前**决定：apt 层改变后，其上的所有层（含 R 包安装，30–90 分钟）都会重建。
#      这是 Docker 分层的机制：构建参数变化会引起该层及其后续层缓存失效。
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
      echo "使用 apt 镜像源: $APT_MIRROR"; \
      sed -i -E "s#https?://(archive|security)\.ubuntu\.com/ubuntu/?#${APT_MIRROR%/}#g" \
        /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true; \
      grep -hE "^URIs:" /etc/apt/sources.list.d/*.sources 2>/dev/null || true; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
      libglpk40 cmake libssl-dev libcurl4-openssl-dev libxml2-dev \
      libhdf5-dev libbz2-dev liblzma-dev \
 && rm -rf /var/lib/apt/lists/*

# ── pak 包管理器 ──────────────────────────────────────────────────────────────
RUN R -e "if (!requireNamespace('pak', quietly=TRUE)) \
            install.packages('pak', repos='https://cloud.r-project.org')"

# ── 锁定 Bioconductor 版本（避免半年后重建得到不同版本）──────────────────────
ARG R_BIOC_VERSION=3.22
ENV R_BIOC_VERSION=${R_BIOC_VERSION}
RUN R -e "if (!requireNamespace('BiocManager', quietly=TRUE)) \
            install.packages('BiocManager', repos='https://cloud.r-project.org'); \
          BiocManager::install(version=Sys.getenv('R_BIOC_VERSION'), \
                               ask=FALSE, update=FALSE)"

# ═══════════════════════════════════════════════════════════════════════════════
#  包源配置
#
#  ⚠️ 两条源码格式约束：
#    1. Bioconductor 不要用 packagemanager.posit.co/bioconductor/... ——
#       PPM 不提供这种格式的 Bioconductor 镜像，该路径全部 404。
#    2. pak::pkg_install() 没有 repos 参数（会报 unused argument）；
#       pak 从 options(repos) 读取仓库，必须用 options() 设置。
#
#  源选择：
#    CRAN : PPM 的 Linux 二进制源免编译，速度最快；不可用时回退清华源
#    Bioc : bioconductor.org 在国内不稳定；西湖大学镜像三个子仓均可访问，优先使用
#
#  BiocManager 与脚本都按 ${BIOC_ROOT}/packages/${版本}/${子仓} 拼 URL，
#  因此只需给一个镜像根即可（与 BiocManager 的拼法一致）。
#
#  换成内网镜像时用 --build-arg 覆盖，无需改本文件。
# ═══════════════════════════════════════════════════════════════════════════════

# CRAN：优先 PPM 二进制（快），回退清华源（稳）
ARG PPM_CRAN="https://packagemanager.posit.co/cran/__linux__/jammy/latest"
ARG CRAN_FALLBACK="https://mirrors.tuna.tsinghua.edu.cn/CRAN"

# Bioconductor 镜像根（脚本据此派生 bioc / data/annotation / data/experiment）
ARG BIOC_ROOT="https://mirrors.westlake.edu.cn/bioconductor"

# ARG 只是构建期变量；用 ENV 固化才能被 R 的 Sys.getenv() 读到
ENV PPM_CRAN=${PPM_CRAN} \
    CRAN_FALLBACK=${CRAN_FALLBACK} \
    BIOC_ROOT=${BIOC_ROOT}

# ── 安装 R 依赖（只声明"我们用到的包"，传递依赖交给 pak 求解器）─────────────────
#   预检 + 多源回退 + 失败时指明具体 URL，避免"跑到一半才失败且看不出原因"。
#   scripts/ 不在应用层"运行期禁止装包"断言的扫描范围内（该断言只扫 seurat_backend/*.R）。
#
#   本地优先源（可选，**只在本机存在**）：.local-r-repo/ 里若放有源码包，
#   安装脚本会优先用它们（网络不稳定时的缓解手段）。它只做只读挂载：
#   **不进镜像、不进构建上下文里的 tar.gz 部分**，别人没有这个目录也不受影响。
COPY scripts/install_r_deps.R /tmp/install_r_deps.R
RUN --mount=type=cache,target=/root/.cache/R/pkgcache \
    --mount=type=bind,source=.local-r-repo,target=/tmp/local-r-repo,ro \
    Rscript /tmp/install_r_deps.R

# ── presto：本地 zip 安装（不在 CRAN/Bioc 上）─────────────────────────────────
COPY shared_data/presto-master.zip /tmp/presto-master.zip
#   ⚠️ 两条约束：
#      1) dependencies=FALSE 不会安装 LinkingTo 依赖（presto 需要 RcppArmadillo），安装会失败；
#      2) install_local() 失败时只报 warning，`R -e` 仍以 0 退出，会静默漏装。
#   因此这里把依赖交给解算器（Depends/Imports/LinkingTo），并追加一条硬断言。
RUN R -e "if(!requireNamespace('remotes', quietly=TRUE)) \
            install.packages('remotes', repos='https://cloud.r-project.org'); \
          remotes::install_local('/tmp/presto-master.zip', upgrade='never', \
                                 dependencies=c('Depends','Imports','LinkingTo'))" \
 && Rscript -e "if (!requireNamespace('presto', quietly=TRUE)) \
                  stop('presto 安装失败（通常是缺 LinkingTo 依赖，如 RcppArmadillo）')" \
 && rm -f /tmp/presto-master.zip

# ── 构建期硬断言：这些包必须可加载（缺一个就 fail，不再让问题溜到运行期）──────
#   每一个都对应真实使用路径：
#     Seurat/harmony      → Step 1–3（质控/降维/聚类）
#     SingleR/celldex/scrapper → Step 4（细胞类型注释）
#     clusterProfiler/fgsea/DOSE/enrichplot → Step 9（富集）
#     rtracklayer/ensembldb → 注释与坐标相关功能
#     presto              → Seurat 的 Wilcoxon 加速路径
RUN Rscript -e "\
  need <- c('Seurat','harmony','SingleR','celldex','scrapper', \
            'clusterProfiler','enrichplot','GOSemSim','DOSE','fgsea', \
            'rtracklayer','ensembldb','presto'); \
  missing <- need[!vapply(need, function(p) requireNamespace(p, quietly=TRUE), logical(1))]; \
  if (length(missing)) stop('缺失 R 包: ', paste(missing, collapse=', ')); \
  cat('✅ 关键 R 包自检通过:', length(need), '个\n')"

# ── 固化版本清单，便于审计与复现 ──────────────────────────────────────────────
RUN R -e "writeLines(capture.output(sessionInfo()), '/opt/scagent-R-sessionInfo.txt')" \
 && R -e "writeLines(sort(rownames(installed.packages())), '/opt/scagent-R-packages.txt')" \
 && R -e "cat('R 包总数:', length(rownames(installed.packages())), '\n')"

WORKDIR /workspace

# ── 非 root 运行（与 agent 镜像一致）─────────────────────────────────────────
#   容器以 uid 1000 运行：产物写进挂载卷时，宿主侧的属主就是部署用户，
#   不会出现"root 写进去、普通用户删不掉"的情况。
#   注意：**不要** useradd —— rocker/tidyverse 基镜像自带 uid 1000 的用户
#   （rstudio，HOME=/home/rstudio，可写），再建会以退出码 4 失败。
#   R 包都装在系统目录（root 所有、全局可读），运行期不需要写 /usr/local/lib；
#   运行期产物一律走 SCAGENT_DATA_DIR（/data）。
RUN mkdir -p /workspace && chown 1000:1000 /workspace
ENV HOME=/home/rstudio
