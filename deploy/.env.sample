# ═══════════════════════════════════════════════════════════════════════════════
#  scAgent 配置模板
#
#  用法：
#      cp deploy/.env.sample deploy/.env
#      chmod 600 deploy/.env          # 内含密钥，必须收紧权限
#      vi deploy/.env                 # 只需填「必填」段
#
#  安全提示：.env 已被 .gitignore 与 .dockerignore 双重排除，
#            绝不会进入 git，也不会被打进镜像。
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
#  必填项
# ─────────────────────────────────────────────────────────────────────────────

# LLM API Key（到 https://platform.deepseek.com/api_keys 创建，形如 sk-xxxx）
DEEPSEEK_API_KEY=sk-请替换为你的密钥

# 客户端访问令牌：浏览器 / CLI / curl 都用它访问本服务
# 生成方式：openssl rand -hex 24   （或 python3 -c "import secrets;print(secrets.token_hex(24))"）
SCAGENT_TOKEN=请替换为随机字符串

# ── 可选：改用文件方式传密钥（生产推荐，见 docker-compose.yml 末尾说明）──
# 设置 *_FILE 后，对应值从文件读取，优先级高于上面的环境变量。
# 好处：密钥不出现在 docker inspect 的 Config.Env 里。
#   SCAGENT_LLM_API_KEY_FILE=/run/secrets/deepseek_api_key
#   SCAGENT_TOKEN_FILE=/run/secrets/scagent_token

# 私有 registry 地址与镜像版本（服务器只从这里拉镜像，绝不访问公网）
SCAGENT_REGISTRY=harbor.example.com/scagent
SCAGENT_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────────────────────
#  常用可调项（不填则使用括号内默认值）
# ─────────────────────────────────────────────────────────────────────────────

# 服务端口（由反向代理转发到它）
SCAGENT_PORT=8080

# 工作目录（存放 10X 原始数据与分析产物）
#   ${SCAGENT_WORKSPACE}/data/rawdata/<样本名>/{barcodes,features,matrix}.tsv.gz
# 注意：相对路径以 deploy/ 为基准解析（与 docker compose 规则一致）；
#       ../workspace 即项目根下的 workspace/。生产环境建议直接写绝对路径。
SCAGENT_WORKSPACE=../workspace

# 参考数据目录（宿主机物理盘，由 download_data.sh 填充，容器内只读挂载）
SCAGENT_BIODATA=/data/biodata

# # HITL 模式
# #   interactive  每次执行分析前需人工确认（默认，推荐）
# #   auto_approve 自动放行（仅用于内网可信环境）
# #   deny_all     全部拒绝（演练/调试）
# SCAGENT_HITL=interactive

# 单次指令最多执行几个工具（默认 2）
# SCAGENT_TOOL_RUN_LIMIT=2

# 并发分析数上限（每个分析内存峰值数 GB，按机器内存调整；推荐 8 核 32 GB 时设 2）
# SCAGENT_MAX_CONCURRENT_RUNS=2

# 网页界面开关（默认开）
# SCAGENT_WEB_UI=true

# ─────────────────────────────────────────────────────────────────────────────
#  LLM 高级选项
# ─────────────────────────────────────────────────────────────────────────────

# SCAGENT_LLM_PROVIDER=deepseek        # deepseek | ollama | none
# SCAGENT_LLM_MODEL=deepseek-v4-flash
# SCAGENT_LLM_BASE_URL=https://api.deepseek.com
# SCAGENT_LLM_TIMEOUT=120
# SCAGENT_LLM_MAX_RETRIES=3

# 历史压缩阈值
# MAX_HISTORY_TOKENS=6000
# KEEP_RECENT_MESSAGES=10
