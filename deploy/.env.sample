# ═══════════════════════════════════════════════════════════════════════════════
#  scAgent 配置模板
#
#  用法：
#      cp deploy/.env.sample deploy/.env
#      chmod 600 deploy/.env          # Linux：内含密钥，必须收紧权限
#      vi deploy/.env                 # 只需填「必填」段
#
#  ⚠️ 编辑要求（Windows 用户必读）：
#      · 必须存成 **UTF-8 无 BOM**、换行 **LF**。用记事本存成 CRLF 会让
#        SCAGENT_TOKEN 尾部多一个 \r，表现为"令牌明明对却一直 401"。
#      · 由脚本（install / configure）生成时可自动满足，推荐用脚本生成。
#      · 路径统一用**正斜杠**、结尾不要带斜杠：D:/scagent/workspace
#
#  安全提示：.env 已被 .gitignore 与 .dockerignore 双重排除，
#            绝不会进入 git，也不会被打进镜像。
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
#  必填项
# ─────────────────────────────────────────────────────────────────────────────

# LLM API Key（到 https://platform.deepseek.com/api_keys 创建，形如 sk-xxxx）
DEEPSEEK_API_KEY=sk-请替换为你的密钥

# 客户端访问令牌：浏览器 / CLI / curl 都用它访问本服务
# 生成方式：openssl rand -hex 24   （或 python3 -c "import secrets;print(secrets.token_hex(24))"）
SCAGENT_TOKEN=请替换为随机字符串

# ── 密钥方式：二选一 ─────────────────────────────────────────────────────────
#  【推荐】Docker secrets（见 deploy/docker-compose.secrets.yml）
#    在 $SCAGENT_SECRETS_DIR/ 下放置两个文件即可：
#        deepseek_api_key   （内容为密钥本身，600）
#        scagent_token      （内容为访问令牌，600）
#    存在这两个文件时 ./deploy/up.sh 会自动叠加 secrets 配置；
#    此时上面两行 DEEPSEEK_API_KEY / SCAGENT_TOKEN 就【不要再填】了。
#    准备命令（target 用上面 SCAGENT_SECRETS_DIR 的同一个路径）：
#        ./scripts/setup_secrets.sh --target /srv/scagent/secrets
#      Windows： 用 PowerShell 里的 deploy\scagent.ps1 secrets（P2 提供）
#    自检：
#        ./scripts/check_secrets.sh --prod
#
#  【回退】环境变量：不建 secrets 目录，直接填上面两行即可。
#
# 密钥目录位置（**建议放在仓库之外**，避免误打包进交付物）
#   Windows： SCAGENT_SECRETS_DIR=D:/scagent/secrets
#   Linux  ： SCAGENT_SECRETS_DIR=/srv/scagent/secrets
SCAGENT_SECRETS_DIR=/srv/scagent/secrets

# ── 镜像来源：三选一（必填）──────────────────────────────────────────────────
#   local   本机 docker compose build 产物（离线可用，首次构建约 30–90 分钟）
#   public  公开发布的镜像（体验最好，直接拉取）
#   private 自有 registry（机构内网）
SCAGENT_IMAGE_SOURCE=public

# 镜像前缀：镜像名 = <前缀>/scagent-<seurat|agent>:<版本>
#   local   → 本地镜像名，不能含主机名（默认 scagent）
#   public  → 公开发布前缀（默认 ghcr.io/17xxxx/scagent）
#   private → 必须显式填写，且含 registry 主机名（如 harbor.corp.local/scagent）
#   国内加速 → crpi-4le1vixwpzhdr5y0.cn-beijing.personal.cr.aliyuncs.com/sqxopen
#              （公开仓库、免登录；注意前缀里不要再拼 scagent-，程序会补）
SCAGENT_IMAGE_PREFIX=ghcr.io/17xxxx/scagent
SCAGENT_VERSION=1.0.0

# 拉取策略：missing = 本地没有才拉（public / private 用这个）
#            never  = 从不联网拉取（local 模式会**强制**成 never，无需手改）
# 手工执行 `docker compose up` 时靠这一行；用 install/up 脚本时会自动推导。
SCAGENT_PULL_POLICY=missing

# ─────────────────────────────────────────────────────────────────────────────
#  常用可调项（不填则使用括号内默认值）
# ─────────────────────────────────────────────────────────────────────────────

# 监听地址：127.0.0.1 = 仅本机（默认，最安全）；
#          0.0.0.0   = 允许局域网访问（另需在 Windows 防火墙放行）
SCAGENT_BIND_ADDR=127.0.0.1

# 服务端口（由反向代理转发到它）
SCAGENT_PORT=8080

# 工作目录（必填，**绝对路径**）—— 存放 10X 原始数据与分析产物
#   ${SCAGENT_WORKSPACE}/data/rawdata/<样本名>/{barcodes,features,matrix}.tsv.gz
#   Windows： SCAGENT_WORKSPACE=D:/scagent/workspace
#   Linux  ： SCAGENT_WORKSPACE=/srv/scagent/workspace
#   目录布局： ${SCAGENT_WORKSPACE}/data  → 容器内 /data
#             ${SCAGENT_WORKSPACE}/state → 容器内 /state（SQLite 检查点）
SCAGENT_WORKSPACE=/srv/scagent/workspace

# 参考数据目录（必填，宿主机物理盘；由 download_data.sh 填充，容器内只读挂载）
#   Windows： SCAGENT_BIODATA=D:/scagent/biodata
#   Linux  ： SCAGENT_BIODATA=/srv/scagent/biodata
SCAGENT_BIODATA=/srv/scagent/biodata

# # HITL 模式
# #   interactive  每次执行分析前需人工确认（默认，推荐）
# #   auto_approve 自动放行（仅用于内网可信环境）
# #   deny_all     全部拒绝（演练/调试）
# SCAGENT_HITL=interactive

# 单次指令最多执行几个工具（默认 2）
# SCAGENT_TOOL_RUN_LIMIT=2

# 并发分析数上限（每个分析内存峰值数 GB，按机器内存调整；推荐 8 核 32 GB 时设 2）
# SCAGENT_MAX_CONCURRENT_RUNS=2

# 网页界面开关（默认开）
# SCAGENT_WEB_UI=true

# ─────────────────────────────────────────────────────────────────────────────
#  LLM 高级选项
# ─────────────────────────────────────────────────────────────────────────────

# SCAGENT_LLM_PROVIDER=deepseek        # deepseek | ollama | none
# SCAGENT_LLM_MODEL=deepseek-v4-flash
# SCAGENT_LLM_BASE_URL=https://api.deepseek.com
# SCAGENT_LLM_TIMEOUT=120
# SCAGENT_LLM_MAX_RETRIES=3

# 历史压缩阈值
# MAX_HISTORY_TOKENS=6000
# KEEP_RECENT_MESSAGES=10
